# Salin file ini menjadi .env, lalu ganti SEMUA nilai CHANGE_ME.
# Jangan mengganti STORAGE_ENCRYPTION_KEY setelah data/provider dibuat.

COMPOSE_PROJECT_NAME=omniroute

# Images
OMNIROUTE_IMAGE=diegosouzapw/omniroute:latest-web
REDIS_IMAGE=docker.io/library/redis:7-alpine
QDRANT_IMAGE=docker.io/qdrant/qdrant:v1.12.4
BIFROST_IMAGE=ghcr.io/maximhq/bifrost:1.5.21
CLIPROXYAPI_IMAGE=ghcr.io/router-for-me/cliproxyapi:v6.9.7

# Container names
OMNIROUTE_CONTAINER_NAME=omniroute
REDIS_CONTAINER_NAME=omniroute-redis
QDRANT_CONTAINER_NAME=omniroute-qdrant
BIFROST_CONTAINER_NAME=omniroute-bifrost
CLIPROXYAPI_CONTAINER_NAME=cliproxyapi

# Network and named volumes for companion services
OMNIROUTE_NETWORK_NAME=omniroute-network
REDIS_VOLUME_NAME=omniroute-redis-data
QDRANT_VOLUME_NAME=omniroute-qdrant-data
BIFROST_VOLUME_NAME=omniroute-bifrost-data
CLIPROXYAPI_VOLUME_NAME=cliproxyapi-data

# SQLite persistence on the Linux filesystem inside WSL.
# Host DB:      /home/yat/development/tools/omniroute/data/storage.sqlite
# Container DB: /app/data/storage.sqlite
HOST_DATA_DIR=/home/yat/development/tools/omniroute/data
DATA_DIR=/app/data
REDIS_URL=redis://redis:6379

# Dashboard and API
PORT=2229
DASHBOARD_PORT=2229
API_PORT=2230
API_HOST=0.0.0.0

# Live dashboard WebSocket
# Browser dashboard: http://localhost:2229
# Browser WebSocket: ws://localhost:22231/live-ws
OMNIROUTE_ENABLE_LIVE_WS=true
LIVE_WS_PORT=22231
LIVE_WS_HOST=0.0.0.0
NEXT_PUBLIC_LIVE_WS_PUBLIC_URL=ws://localhost:22231/live-ws
LIVE_WS_ALLOWED_ORIGINS=http://localhost:2229,http://127.0.0.1:2229

# Memory limit used by OmniRoute
OMNIROUTE_MEMORY_MB=2048

# Generate new values before first run:
#   openssl rand -base64 48  # JWT_SECRET
#   openssl rand -hex 32     # API_KEY_SECRET
#   openssl rand -hex 32     # STORAGE_ENCRYPTION_KEY
#   openssl rand -base64 32  # OMNIROUTE_WS_BRIDGE_SECRET
#   openssl rand -base64 18  # INITIAL_PASSWORD
JWT_SECRET=CHANGE_ME
API_KEY_SECRET=CHANGE_ME
STORAGE_ENCRYPTION_KEY=CHANGE_ME
STORAGE_ENCRYPTION_KEY_VERSION=v1
OMNIROUTE_WS_BRIDGE_SECRET=CHANGE_ME
INITIAL_PASSWORD=CHANGE_ME

DISABLE_SQLITE_AUTO_BACKUP=false

# Optional services
QDRANT_ENABLED=false
BIFROST_ENABLED=false
CLIPROXYAPI_ENABLED=false

QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
BIFROST_PORT=8080
CLIPROXYAPI_PORT=8317
BIFROST_LOG_LEVEL=info

# Remote Settings Sync is separate from Live WebSocket and SQLite persistence.
# Leave unset when you do not operate a remote sync server.
# CLOUD_URL=https://sync.example.com
# OMNIROUTE_CLOUD_SYNC_SECRET=CHANGE_ME
# OMNIROUTE_CLOUD_SYNC_SECRETS=false

# Total waktu untuk seluruh rantai combo
REQUEST_TIMEOUT_MS=600000
FETCH_TIMEOUT_MS=600000

# Provider harus menghasilkan SSE berguna dalam 30 detik
STREAM_READINESS_TIMEOUT_MS=30000

# Batas adaptif untuk prompt besar/reasoning
STREAM_READINESS_MAX_TIMEOUT_MS=60000

# Jangan biarkan agentic request menaikkan readiness sampai 10 menit
OMNIROUTE_AGENT_GOAL_READINESS_MAX_TIMEOUT_MS=60000

# Stream yang sudah berjalan diputus jika diam selama 90 detik
STREAM_IDLE_TIMEOUT_MS=300000

# Hindari retry stream yang menambah latensi dan duplikasi
STREAM_RECOVERY_ENABLED=false
STREAM_RECOVERY_MIDSTREAM_ENABLED=false