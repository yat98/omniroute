# Copy to .env and replace every CHANGE_ME value.
# Existing installation: reuse the current secrets, especially
# STORAGE_ENCRYPTION_KEY. Changing it makes stored credentials unreadable.

COMPOSE_PROJECT_NAME=omniroute

# Exact digest observed on the healthy v3.8.49 rebuild supplied for this audit.
OMNIROUTE_IMAGE=diegosouzapw/omniroute@sha256:92c768c56e2de32c51a0621ef182835018b00b288c9bb235c5c5e4514658c1a1
REDIS_IMAGE=docker.io/library/redis:7-alpine

# Container names
OMNIROUTE_CONTAINER_NAME=omniroute
REDIS_CONTAINER_NAME=omniroute-redis
OMNIROUTE_NETWORK_NAME=omniroute-network
REDIS_VOLUME_NAME=omniroute-redis-data

# Keep SQLite on the WSL Linux filesystem, not /mnt/c.
HOST_DATA_DIR=/home/yat/development/tools/omniroute/data
DATA_DIR=/app/data
REDIS_URL=redis://redis:6379

DASHBOARD_PORT=2229
API_PORT=2230
API_HOST=0.0.0.0

OMNIROUTE_ENABLE_LIVE_WS=true
LIVE_WS_PORT=2231
LIVE_WS_HOST=0.0.0.0
NEXT_PUBLIC_LIVE_WS_PUBLIC_URL=ws://localhost:2231/live-ws
LIVE_WS_ALLOWED_ORIGINS=http://localhost:2229,http://127.0.0.1:2229

OMNIROUTE_MEMORY_MB=3072

# Generate these only for a fresh installation. For an existing database,
# copy the values from the current .env instead.
JWT_SECRET=CHANGE_ME
API_KEY_SECRET=CHANGE_ME
STORAGE_ENCRYPTION_KEY=CHANGE_ME
STORAGE_ENCRYPTION_KEY_VERSION=v1
OMNIROUTE_WS_BRIDGE_SECRET=CHANGE_ME
INITIAL_PASSWORD=CHANGE_ME

DISABLE_SQLITE_AUTO_BACKUP=false

# Do not set REQUEST_TIMEOUT_MS. It is a shared override that can silently
# replace the more specific readiness and stream-idle limits below.
FETCH_TIMEOUT_MS=300000
FETCH_HEADERS_TIMEOUT_MS=90000
FETCH_BODY_TIMEOUT_MS=300000
FETCH_CONNECT_TIMEOUT_MS=30000
FETCH_KEEPALIVE_TIMEOUT_MS=15000

STREAM_READINESS_TIMEOUT_MS=90000
STREAM_READINESS_MAX_TIMEOUT_MS=120000
OMNIROUTE_AGENT_GOAL_READINESS_MAX_TIMEOUT_MS=120000
STREAM_IDLE_TIMEOUT_MS=120000
SSE_HEARTBEAT_INTERVAL_MS=15000

API_BRIDGE_PROXY_TIMEOUT_MS=330000
API_BRIDGE_SERVER_REQUEST_TIMEOUT_MS=340000
API_BRIDGE_SERVER_HEADERS_TIMEOUT_MS=120000
API_BRIDGE_SERVER_KEEPALIVE_TIMEOUT_MS=65000

STREAM_RECOVERY_ENABLED=false
STREAM_RECOVERY_MIDSTREAM_ENABLED=false

# Never bypass a configured proxy silently. This prevents real-IP leakage
# from free proxy pools when a proxy fails.
PROXY_FAIL_OPEN=false

OMNIROUTE_CHAT_MAX_HEAVY_IN_FLIGHT=4
